{
  "name": "ai-health-screening-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time AI health screening voice agent built with React, Node.js, TypeScript, STT, Gemini and TTS.",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm --prefix client run build",
    "build:server": "npm --prefix server run build"
  },
  "keywords": [
    "ai",
    "voice-ai",
    "healthcare",
    "gemini",
    "react",
    "nodejs",
    "typescript",
    "websocket"
  ],
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
